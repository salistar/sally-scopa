{
  "expo": {
    "name": "Sally Scopa",
    "slug": "scopa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#065F46",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#065F46"
      }
    },
    "scheme": "sallycards",
    "ios": {
      "bundleIdentifier": "com.sallycards.scopa",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Scopa utilise votre position pour la carte des hkim."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAa1lBSroSXA-Om4mio84-SWAcmzQgYv8w"
      }
    },
    "android": {
      "package": "com.sallycards.scopa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAa1lBSroSXA-Om4mio84-SWAcmzQgYv8w"
        }
      },
      "versionCode": 5
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scopa utilise votre position pour la carte des hkim."
        }
      ]
    ],
    "newArchEnabled": false,
    "extra": {
      "usesCleartextTraffic": true,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1b91bd39-0f91-46b6-9ae7-2688ab2be314"
      }
    },
    "owner": "idriss.kriouile"
  }
}